#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=64
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=3850
#SBATCH --account=su007-bk
#SBATCH --partition=compute
#SBATCH --time=02:00:00
#SBATCH --job-name=scf_%STRUCT_NAME%
#SBATCH --output=%STRUCT_DIR%/scf/slurm-%j.out
#SBATCH --error=%STRUCT_DIR%/scf/slurm-%j.err

module purge
module load intel/2019b HDF5/1.10.5

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
unset I_MPI_PMI_LIBRARY

# IMPORTANT: this MUST be vasp_std, not vasp_gam. vasp_gam is compiled to
# only support the Gamma point -- it cannot run the multi-k-point SCF mesh
# or (in the bands stage) the explicit seekpath k-point list this workflow
# needs. Your usual single-job script defaults to vasp_gam; that default
# would silently break this workflow.
path=$HOME/APPS/vasp.6.4.2/bin/
exe=vasp_std
APP=$path/$exe

export ASE_VASP_COMMAND="srun $APP"
export VASP_PP_PATH=REPLACE_ME_PATH_TO_POTCARS   # e.g. $HOME/APPS/POTCARs (PBE)

# activate whichever conda/venv has ase + pymatgen + seekpath installed
# e.g.: source ~/miniconda3/bin/activate bandgap-env
REPLACE_ME_ENV_ACTIVATION

python run_scf.py "%STRUCT_FILE%" "%RUN_ROOT%"
