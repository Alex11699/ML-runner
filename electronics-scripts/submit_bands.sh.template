#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=128
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=3850
#SBATCH --account=su007-bk
#SBATCH --partition=compute
#SBATCH --time=02:00:00
#SBATCH --job-name=bands_%STRUCT_NAME%
#SBATCH --output=%STRUCT_DIR%/bands/slurm-%j.out
#SBATCH --error=%STRUCT_DIR%/bands/slurm-%j.err

module purge
module load intel/2019b HDF5/1.10.5

export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
unset I_MPI_PMI_LIBRARY

ulimit -s unlimited #needed for VASP !!!

# Same vasp_std requirement as the SCF step -- vasp_gam cannot run the
# explicit multi-point seekpath band path.
path=$HOME/APPS/vasp.6.3.2
exe=vasp_std
APP=$path/$exe

export ASE_VASP_COMMAND="srun $APP"
export VASP_PP_PATH="/home/m/msrbzq/VASP-PPs"
export VDW_KERNEL_PATH="$HOME/APPS/vasp.6.3.2/vdw_kernel.bindat"

source /home/m/msrbzq/APPS/miniconda3/etc/profile.d/conda.sh
conda activate bandgap-env

# Optional efficiency note (not required for correctness): the bands step
# has ~150-200 explicit k-points and no self-consistency to worry about, so
# it's a good candidate for VASP's KPAR k-point parallelization on top of
# NPAR. Not applied here since it changes nothing about correctness, only
# wall-time.
cd %CODE_DIR%
python run_bands.py "%STRUCT_FILE%" "%RUN_ROOT%"
